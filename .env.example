# Copy to .env for local use, or set these in Coolify → Environment Variables

# --- Frappe version ---
FRAPPE_VERSION=v16
FRAPPE_BRANCH=version-16

# Apps come from the ./apps folder — no env vars needed. To add an app
# (e.g. Frappe CRM), drop its folder into apps/ and rebuild.

# --- Credentials (use strong random values in production) ---
MYSQL_ROOT_PASSWORD=changeme
ADMIN_PASSWORD=changeme

# --- Site / domains ---
# Frappe site name MUST equal the Desk public hostname (no scheme).
# Coolify example: desk.example.com
# Local example:   vendors.localhost
FRAPPE_SITE_NAME=vendors.localhost

# Public HTTPS origin for Frappe (Coolify Desk URL). Leave empty for local HTTP.
# Coolify example: https://desk.example.com
# Must be a full URL — never leave as bare "https://"
SITE_HOST_NAME=

# --- Network / proxy ---
# Trust Coolify proxy for real client IPs.
# Set to Coolify's internal Docker subnet for production — NOT 0.0.0.0/0.
# Find it: docker network inspect coolify | grep Subnet
# Default (matches Docker bridge RFC-1918): 172.16.0.0/12
UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12

# --- Local ports only (docker-compose.dev.yml) ---
FRAPPE_PORT=8080

# --- Image (optional) ---
# Override to pull a pre-built image from a registry instead of building locally.
# Example: ghcr.io/your-org/vendor-billing-frappe:latest
# FRAPPE_IMAGE=vendor-billing-frappe:latest

# --- Resource limits (optional — defaults suit a shared Coolify host) ---
# Caps total ~2.2 GB RAM / ~3.5 CPU so other apps on the same server still run.
# Raise these if this stack is the only tenant, or if you see OOMKilled.
# DB_MEM_LIMIT=512M
# DB_CPU_LIMIT=0.75
# DB_INNODB_BUFFER=256M   # ~50 % of DB_MEM_LIMIT
# DB_MAX_CONNECTIONS=50
# BACKEND_MEM_LIMIT=640M
# BACKEND_CPU_LIMIT=1.0
# WORKER_MEM_LIMIT=320M
# WORKER_CPU_LIMIT=0.5
# REDIS_CACHE_MEM_LIMIT=64M
# REDIS_CACHE_MAXMEMORY=48mb
# REDIS_QUEUE_MEM_LIMIT=80M
# REDIS_QUEUE_MAXMEMORY=64mb

# --- Gunicorn (keep workers low on a shared host) ---
# Each worker is ~80–150 MB. 2 × 2 is the shared-host default.
# Do not leave workers blank — nproc sees HOST cores on Coolify.
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=60
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100

# --- Coolify notes ---
# After first deploy, set a domain on:
#   frappe-nginx → desk.example.com     (port 8080)
# Then set:
#   FRAPPE_SITE_NAME=desk.example.com
#   SITE_HOST_NAME=https://desk.example.com
# If the Frappe site was already created with a different name, recreate the
# `sites` volume OR create a matching site — Frappe site name is not freely renameable.
